[Unit]
Description=Lighthouse Agent Board MCP Action Runner
After=network.target lighthouse-review-room.service
Wants=lighthouse-review-room.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/review-room-service
EnvironmentFile=/home/ubuntu/review-room-service/mcp-runner.env
ExecStart=/home/ubuntu/review-room-service/.venv/bin/python /home/ubuntu/review-room-service/mcp_action_runner.py
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
